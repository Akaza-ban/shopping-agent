APP_NAME="ShopAI Agent Backend"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]

LLM_PROVIDER="deepseek"

# 1. Cấu hình DeepSeek API bản trả tiền chính thức (Khuyên dùng)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 2. Cấu hình Groq API (Siêu nhanh, miễn phí)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Cấu hình OpenRouter API (Hỗ trợ đa model)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"
OPENROUTER_MODEL="deepseek/deepseek-chat"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Model nhanh, rẻ qua OpenRouter cho phân tích ý định, lọc sản phẩm và viết câu trả lời; để trống -> dùng model chính
FAST_LLM_MODEL="google/gemini-2.5-flash-lite"
# Chỉ định nhà cung cấp trên OpenRouter cho model nhanh (VD: Groq); để trống -> OpenRouter tự chọn
FAST_LLM_PROVIDER=""

EMBEDDING_MODEL="baai/bge-m3"
# Để trống -> dùng OPENROUTER_API_KEY / OPENROUTER_BASE_URL; điền nếu dùng nhà cung cấp khác tương thích OpenAI
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_QUERY_TIMEOUT_SECONDS=8
# Collection ChromaDB (đổi model embedding -> đổi tên collection rồi chạy python -m scripts.reindex_rag)
RAG_COLLECTION="products_v2"
RAG_MAX_AGE_DAYS=30


LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_PROJECT="shopai-agent"
# Tùy chọn endpoint:
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

DATABASE_URL="sqlite+aiosqlite:///./shopai.db"
REDIS_URL="redis://localhost:6379/0"

PRICE_WATCH_INTERVAL_MINUTES=360

ADMIN_EMAILS=

# Email đặt lại mật khẩu (để trống: môi trường development ghi link ra log server)
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
FRONTEND_URL="http://localhost:3000"
PASSWORD_RESET_TTL_MINUTES=30
