ả về giá, tình trạng hàng" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="746.9" y="269.1" width="131.8" height="45.5" as="geometry"/></mxCell><mxCell id="c9" value="Đọc được giá và còn hàng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305.8" y="348.4" width="195.0" height="59.8" as="geometry"/></mxCell><mxCell id="c10" value="Ghi chú, giữ trạng thái, kiểm tra lại sau" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540.3" y="355.6" width="150.3" height="45.5" as="geometry"/></mxCell><mxCell id="c11" value="Giá hợp lệ và không biến động bất thường?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305.8" y="447.2" width="195.0" height="59.8" as="geometry"/></mxCell><mxCell id="c12" value="Bỏ qua hoặc chờ lần đọc sau xác nhận" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540.3" y="454.4" width="150.3" height="45.5" as="geometry"/></mxCell><mxCell id="c13" value="Giá ≤ giá mong muốn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305.8" y="546.0" width="195.0" height="59.8" as="geometry"/></mxCell><mxCell id="c14" value="Cập nhật giá gần nhất, thấp nhất" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540.3" y="553.1" width="150.3" height="45.5" as="geometry"/></mxCell><mxCell id