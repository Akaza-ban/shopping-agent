    "/api/chat/stream": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat Stream Post",
        "description": "Streaming SSE Chat API (POST).\nTrả về dòng sự kiện Server-Sent Events (SSE):\n- event: status -> Cập nhật trạng thái xử lý ('routing', 'crawling', 'synthesizing'...)\n- event: products -> Trả về danh sách sản phẩm ngay khi cào xong để UI render trước\n- event: comparison -> Bảng so sánh có cấu trúc {summary, table: {columns, rows}} khi có >= 2 sản phẩm\n- event: clarification -> Câu hỏi làm rõ {question, options[]} khi yêu cầu còn quá chung (VD: thiếu ngân sách)\n- event: token -> Stream từng từ phản hồi của LLM trong thời gian thực\n- event: suggestions -> Trả về các câu hỏi gợi ý tiếp theo\n- event: done -> Báo hiệu hoàn tất lượt chat",
        "operationId": "chat_stream_post_api_chat_stream_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat Stream Get",
        "description": "Streaming SSE Chat API (GET) phục vụ Native HTML5 EventSource (token truyền qua ?access_token=).",
        "operationId": "chat_stream_get_api_chat_stream_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          },
          {
            "name": "message",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Message"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "all",
              "title": "Platform"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "vi",
                "en"
              ],
              "type": "string",
              "default": "vi",
              "title": "Language"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
